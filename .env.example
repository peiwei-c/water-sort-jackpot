# Copy to .env for local native AdMob builds (optional overrides).
# EXPO_PUBLIC_AD_PROVIDER=admob
# EXPO_PUBLIC_ALLOW_MOCK_MONETIZATION=false
# EXPO_PUBLIC_PRIVACY_URL=https://peiwei-c.github.io/water-sort-jackpot/privacy.html
# EXPO_PUBLIC_TERMS_URL=https://peiwei-c.github.io/water-sort-jackpot/terms.html
# EXPO_PUBLIC_SUPPORT_EMAIL=you@example.com
#
# IAP — must match App Store Connect + Play Console non-consumable product
# EXPO_PUBLIC_IAP_REMOVE_ADS_ID=com.aquasort.lab.remove_ads
#
# Android (defaults already in code)
# EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-…/…
# EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-…/…
# EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_ID=ca-app-pub-…/…
#
# iOS (defaults already in code)
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-3994151354323315~6719971499
# EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-3994151354323315/5156588324
# EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-3994151354323315/8496087594
# EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=ca-app-pub-3994151354323315/8416910554
