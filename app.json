{
  "expo": {
    "name": "AquaSort Lab",
    "slug": "water-sort-jackpot",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "primaryColor": "#0C2A32",
    "description": "Sort colorful reagents in glass flasks, then spin the Centrifuge for boosts. A hydrology-lab puzzle with optional rewarded ads.",
    "privacy": "public",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aquasort.lab",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aquasort.lab",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0C2A32",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "legal": {
        "privacyUrl": "https://peiwei-c.github.io/water-sort-jackpot/privacy.html",
        "termsUrl": "https://peiwei-c.github.io/water-sort-jackpot/terms.html",
        "supportEmail": "support@aquasort.lab"
      },
      "eas": {
        "projectId": "7a3cbff1-d05e-47f3-ba38-01dab8cd8d82"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06141C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3994151354323315~6576501262",
          "iosAppId": "ca-app-pub-3994151354323315~6719971499",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      "expo-iap"
    ],
    "owner": "peiwei_c"
  }
}
